{
  "name": "dsh-chat-trash",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "Permanently delete a chat from the DeepSeek Harness sidebar: log and cache removed, no archive copy left behind.",
  "author": {
    "name": "mars-area",
    "url": "https://github.com/mars-area"
  },
  "contributors": [
    {
      "name": "mars-area",
      "url": "https://github.com/mars-area"
    }
  ],
  "homepage": "https://github.com/mars-area/dsh-chat-trash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mars-area/dsh-chat-trash.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "delete-chat"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
